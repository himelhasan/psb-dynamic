# Database
# On Render: copy the connection string from your managed Postgres instance
# Locally: adjust for your local Postgres setup (e.g., localhost)
DATABASE_URL="postgresql://user:password@localhost:5432/psb"

# Auth secret — generate with: `openssl rand -base64 32`
AUTH_SECRET="your-long-random-secret-here-min-32-chars"

# Seed script will use these to create the first admin user
# Change these after first login!
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme"

# Next.js
NODE_ENV="development"
